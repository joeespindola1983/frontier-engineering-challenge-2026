{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake-rowing.dev/schemas/environment-timeline.schema.json",
  "title": "WAKE Environment Timeline",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "timeline_id", "source", "direction_convention", "samples"],
      "properties": {
        "schema_version": {"const": "wake.environment_timeline.v1"},
        "timeline_id": {"type": "string"},
        "source": {"$ref": "#/$defs/source_v1"},
        "direction_convention": {"const": "METEOROLOGICAL_FROM_DEGREES_TRUE_NORTH"},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample_v1"}}
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "timeline_id", "source", "location", "session_window", "direction_convention", "units", "time_basis", "samples", "limitations"],
      "properties": {
        "schema_version": {"const": "wake.environment_timeline.v2"},
        "timeline_id": {"type": "string"},
        "source": {"$ref": "#/$defs/source_v2"},
        "location": {"$ref": "#/$defs/location_v2"},
        "session_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_utc", "end_utc"],
          "properties": {
            "start_utc": {"type": "string", "format": "date-time"},
            "end_utc": {"type": "string", "format": "date-time"}
          }
        },
        "direction_convention": {"const": "METEOROLOGICAL_FROM_DEGREES_TRUE_NORTH"},
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wind_speed", "temperature", "relative_humidity"],
          "properties": {
            "wind_speed": {"const": "m/s"},
            "temperature": {"const": "celsius"},
            "relative_humidity": {"const": "percent"}
          }
        },
        "time_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_timezone", "provider_utc_offset_seconds", "temporal_resolution_minutes", "interpolation", "session_timezone_source", "assumed_session_timezone"],
          "properties": {
            "provider_timezone": {"type": "string"},
            "provider_utc_offset_seconds": {"type": "integer"},
            "temporal_resolution_minutes": {"type": "integer", "minimum": 1},
            "interpolation": {"enum": ["NONE", "LINEAR"]},
            "session_timezone_source": {"enum": ["TELEMETRY_OFFSET", "USER_SUPPLIED_IANA"]},
            "assumed_session_timezone": {"type": ["string", "null"]}
          }
        },
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample_v2"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "source_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_ref", "quality"],
      "properties": {
        "kind": {"enum": ["WEATHER_STATION", "WEATHER_API", "ON_BOAT_SENSOR", "HUMAN", "SYNTHETIC"]},
        "source_ref": {"type": "string"},
        "quality": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}
      }
    },
    "source_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_ref", "quality", "provider", "dataset", "model", "spatial_resolution_km", "temporal_resolution_minutes", "retrieved_at", "attribution"],
      "properties": {
        "kind": {"const": "WEATHER_API"},
        "source_ref": {"type": "string"},
        "quality": {"enum": ["MEDIUM", "LOW", "UNKNOWN"]},
        "provider": {"type": "string"},
        "dataset": {"type": "string"},
        "model": {"type": "string"},
        "spatial_resolution_km": {"type": ["number", "null"], "minimum": 0},
        "temporal_resolution_minutes": {"type": "integer", "minimum": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "attribution": {"type": "string"}
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "location_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_coordinate_rounded", "returned_grid_coordinate", "precision_decimals"],
      "properties": {
        "requested_coordinate_rounded": {"$ref": "#/$defs/coordinate"},
        "returned_grid_coordinate": {"$ref": "#/$defs/coordinate"},
        "precision_decimals": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "sample_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "wind_speed_m_s", "wind_direction_deg", "gust_speed_m_s", "temperature_c"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "wind_speed_m_s": {"type": "number", "minimum": 0},
        "wind_direction_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "gust_speed_m_s": {"type": ["number", "null"], "minimum": 0},
        "temperature_c": {"type": ["number", "null"]}
      }
    },
    "sample_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "wind_speed_m_s", "wind_direction_deg", "gust_speed_m_s", "temperature_c", "relative_humidity_pct"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "wind_speed_m_s": {"type": "number", "minimum": 0},
        "wind_direction_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "gust_speed_m_s": {"type": ["number", "null"], "minimum": 0},
        "temperature_c": {"type": ["number", "null"]},
        "relative_humidity_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      }
    }
  }
}
