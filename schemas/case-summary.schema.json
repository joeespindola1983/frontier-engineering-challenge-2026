{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake-rowing.dev/schemas/case-summary.schema.json",
  "title": "WAKE Compact Case Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary_id", "case_id", "generated_by", "input_hashes", "investigation_request", "domain_knowledge", "known_context", "plan", "sources", "cross_source_findings", "environment", "evidence_gaps"],
  "properties": {
    "schema_version": {"const": "wake.case_summary.v1"},
    "summary_id": {"type": "string"},
    "case_id": {"type": "string"},
    "generated_by": {"type": "string"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "investigation_request": {"type": "string"},
    "domain_knowledge": {"type": "array", "items": {"$ref": "#/$defs/domain_fact"}},
    "known_context": {"type": "object"},
    "plan": {"type": ["object", "null"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source_summary"}},
    "cross_source_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "environment": {"type": ["object", "null"]},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "domain_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "meaning", "status", "limitations"],
      "properties": {
        "term": {"type": "string"},
        "meaning": {"type": "string"},
        "status": {"enum": ["HUMAN_CONFIRMED", "AUTHORITATIVE_REFERENCE", "UNKNOWN"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "evidence_refs", "metrics", "quality_flags", "time_series_windows"],
      "properties": {
        "source_id": {"type": "string"},
        "kind": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "object"},
        "quality_flags": {"type": "array", "items": {"type": "string"}},
        "time_series_windows": {"type": "array", "items": {"type": "object"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "type", "summary", "values", "evidence_refs"],
      "properties": {
        "finding_id": {"type": "string"},
        "type": {"type": "string"},
        "summary": {"type": "string"},
        "values": {"type": "object"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
