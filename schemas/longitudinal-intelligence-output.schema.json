{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake-rowing.dev/schemas/longitudinal-intelligence-output.schema.json",
  "title": "WAKE Longitudinal Intelligence Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "scope",
    "headline",
    "observed_facts",
    "comparisons",
    "priorities",
    "unresolved_questions",
    "recommendations",
    "boundaries",
    "coach_briefing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "wake.longitudinal_intelligence_output.v1"
    },
    "pilot_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entity_id"],
      "properties": {
        "type": {"enum": ["ATHLETE", "CLUB"]},
        "entity_id": {"type": "string", "minLength": 1}
      }
    },
    "headline": {"type": "string", "minLength": 1},
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact"}
    },
    "comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"}
    },
    "priorities": {
      "type": "array",
      "items": {"$ref": "#/$defs/priority"}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    },
    "recommendations": {
      "type": "array",
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "coach_briefing": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "statement", "confidence", "evidence_refs"],
      "properties": {
        "fact_id": {"type": "string"},
        "statement": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "status", "statement", "evidence_refs", "limitations"],
      "properties": {
        "comparison_id": {"type": "string"},
        "status": {"enum": ["SUPPORTED", "INSUFFICIENT", "CONFLICTED"]},
        "statement": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority_id", "rank", "action", "reason", "requires_human_review", "evidence_refs"],
      "properties": {
        "priority_id": {"type": "string"},
        "rank": {"type": "integer", "minimum": 1},
        "action": {"type": "string"},
        "reason": {"type": "string"},
        "requires_human_review": {"type": "boolean", "const": true},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "expected_respondent", "question", "reason", "evidence_refs"],
      "properties": {
        "question_id": {"type": "string"},
        "expected_respondent": {"enum": ["ATHLETE", "COACH", "ATHLETE_OR_COACH"]},
        "question": {"type": "string"},
        "reason": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_id", "status", "action", "rationale", "evidence_refs", "limitations"],
      "properties": {
        "recommendation_id": {"type": "string"},
        "status": {"enum": ["REVIEW_REQUIRED", "INFORMATION_REQUEST"]},
        "action": {"type": "string"},
        "rationale": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
