{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake-rowing.dev/schemas/ground-truth.schema.json",
  "title": "WAKE Evaluation Ground Truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_version", "applicable_dimensions", "expected_session_matches", "expected_segments", "expected_source_policy", "expected_claims", "required_abstentions", "required_questions", "tolerances"],
  "properties": {
    "schema_version": {"const": "wake.evaluation_ground_truth.v1"},
    "fixture_id": {"type": "string"},
    "fixture_version": {"type": "string"},
    "applicable_dimensions": {"type": "array", "items": {"type": "string"}},
    "expected_session_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ids", "decision", "clock_offset_s"],
        "properties": {
          "source_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "decision": {"enum": ["MATCH", "NO_MATCH", "INSUFFICIENT"]},
          "clock_offset_s": {"type": ["number", "null"]}
        }
      }
    },
    "expected_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "kind", "start_offset_s", "end_offset_s", "distance_m", "average_speed_m_s", "average_spm", "compliance"],
        "properties": {
          "segment_id": {"type": "string"},
          "kind": {"enum": ["WORK", "RECOVERY", "WARMUP", "COOLDOWN"]},
          "start_offset_s": {"type": "number"},
          "end_offset_s": {"type": "number"},
          "distance_m": {"type": ["number", "null"]},
          "average_speed_m_s": {"type": ["number", "null"]},
          "average_spm": {"type": ["number", "null"]},
          "compliance": {"enum": ["COMPLIANT", "DEVIATION", "UNKNOWN", "NOT_APPLICABLE"]}
        }
      }
    },
    "expected_source_policy": {"type": "object", "additionalProperties": {"type": "string"}},
    "expected_claims": {"type": "array", "items": {"$ref": "#/$defs/expected_claim"}},
    "required_abstentions": {"type": "array", "items": {"type": "string"}},
    "required_questions": {"type": "array", "items": {"type": "string"}},
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_boundary_s", "distance_m", "stroke_rate_spm", "clock_offset_s"],
      "properties": {
        "segment_boundary_s": {"type": "number", "minimum": 0},
        "distance_m": {"type": "number", "minimum": 0},
        "stroke_rate_spm": {"type": "number", "minimum": 0},
        "clock_offset_s": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "expected_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "expectation", "evidence_refs"],
      "properties": {
        "claim_id": {"type": "string"},
        "expectation": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
