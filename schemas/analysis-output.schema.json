{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake-rowing.dev/schemas/analysis-output.schema.json",
  "title": "WAKE Session Analysis Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "session_associations", "plan_summary", "segments", "source_policy", "claims", "deviations", "environment_assessment", "abstentions", "follow_up_questions", "coach_briefing"],
  "properties": {
    "schema_version": {"type": "string", "const": "wake.analysis_output.v1.1"},
    "case_id": {"type": "string"},
    "session_associations": {"type": "array", "items": {"$ref": "#/$defs/association"}},
    "plan_summary": {"$ref": "#/$defs/plan_summary"},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "source_policy": {"type": "array", "items": {"$ref": "#/$defs/source_policy"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "deviations": {"type": "array", "items": {"$ref": "#/$defs/deviation"}},
    "environment_assessment": {"$ref": "#/$defs/environment_assessment"},
    "abstentions": {"type": "array", "items": {"type": "string"}},
    "follow_up_questions": {"type": "array", "items": {"type": "string"}},
    "coach_briefing": {"type": "string"}
  },
  "$defs": {
    "plan_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "summary", "prescribed_blocks", "evidence_refs"],
      "properties": {
        "status": {"enum": ["NOT_SUPPLIED", "PARSED", "PARTIAL", "CONFLICTED"]},
        "summary": {"type": "string"},
        "prescribed_blocks": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environment_assessment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["summary", "association", "confidence", "evidence_refs", "limitations"],
      "properties": {
        "summary": {"type": "string"},
        "association": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "CONFLICTED", "UNKNOWN"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "decision", "confidence", "reason", "evidence_refs"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "decision": {"enum": ["MATCH", "NO_MATCH", "INSUFFICIENT"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "kind", "start_offset_s", "end_offset_s", "distance_m", "average_spm", "confidence", "evidence_refs"],
      "properties": {
        "segment_id": {"type": "string"},
        "kind": {"enum": ["WORK", "RECOVERY", "WARMUP", "COOLDOWN", "UNKNOWN"]},
        "start_offset_s": {"type": ["number", "null"]},
        "end_offset_s": {"type": ["number", "null"]},
        "distance_m": {"type": ["number", "null"]},
        "average_spm": {"type": ["number", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "selected_source_id", "confidence", "reason", "evidence_refs"],
      "properties": {
        "metric": {"type": "string"},
        "selected_source_id": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "status", "confidence", "evidence_refs", "limitations"],
      "properties": {
        "claim_id": {"type": "string"},
        "statement": {"type": "string"},
        "status": {"enum": ["OBSERVED", "DERIVED", "HUMAN_CONFIRMED", "INFERRED", "CONFLICTED", "UNKNOWN", "UNSUPPORTED"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_ref", "type", "description", "confidence", "evidence_refs"],
      "properties": {
        "segment_ref": {"type": ["string", "null"]},
        "type": {"type": "string"},
        "description": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
